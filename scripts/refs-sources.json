      "automated": true,
      "terms": "no clause in /legal; robots.txt disallows /?s= searches, so tag/genre pages only (it also sells an API)",
      "search": "https://onepagelove.com/{cat}",
      "cats": {
        "skin|beauty|cosmetic|makeup|fragrance|perfume|hair": "tag/beauty",
        "food|drink|coffee|restaurant|cafe|bakery": "genre/restaurant",
        "sport|fitness|gym": "genre/sport"
      },
      "default": "genre/product-physical",
      "item": "\\?ref=onepagelove$",
      "visit": "direct",
      "per": 2
    },
