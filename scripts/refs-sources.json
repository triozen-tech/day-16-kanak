{
  "_readme": "Sources for `npm run refs`, `npm run refs:search` and `npm run refs:login` (docs/REFERENCE-SOURCES.md). automated:false = browse by hand only: the collector never opens these hosts (refs:search only builds links to Pinterest, Dribbble and Behance). login:true = gets a tab in refs:login. search: {cat} = the slug from `cats` (first key whose words appear in the category, else `default`), {q} = the category words. item = regex for entry links on that page. visit: entry (open the entry, follow its 'visit site' link, visitSelector first) · direct (the item link IS the live site). strict = broad category buckets: only entries that mention the category. fallback = only used when the other galleries gave too few sources. sections = the section library (kind: top · grid · pdp · text (heading words) · email · footer; search = the words used on the search sheet); sectionPresets = suggested section list per business; otherPools = creative award-gallery pages for the 'any business' options; styleWords = rotating style words for the search sheet; brands = same-business live sites per category. Checked 2026-10-09.",
  "sources": [
    {
      "id": "awwwards",
      "name": "Awwwards",
      "url": "https://www.awwwards.com/",
      "login": true,
      "loginUrl": "https://www.awwwards.com/login/",
      "automated": true,
      "terms": "no automated-access clause; robots.txt disallows /websites/? searches, so category pages only",
      "search": "https://www.awwwards.com/websites/{cat}/",
      "cats": {
        "fashion|apparel|clothing|footwear|shoe|sneaker|jewel|watch": "fashion",
        "hotel|hospitality|restaurant|cafe|coffee|food|bar": "hotel-restaurant",
        "architect|interior|furniture|real estate": "architecture"
      },
      "default": "e-commerce",
      "item": "^https://www\\.awwwards\\.com/sites/[a-z0-9-]+/?$",
      "visit": "entry",
      "own": [
        "awwwards.com"
      ],
      "per": 2,
      "visitSelector": "a.toolbar-bts__item[target=_blank][href^='http'], a.figure-rollover__bt[href^='http']",
      "strict": true
    },
    {
      "id": "onepagelove",
      "name": "One Page Love",
